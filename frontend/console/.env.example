# Copy to .env.local for local overrides. Vite only exposes VITE_* to the
# browser, and these are baked in at build time — a change here needs a
# rebuild, not a restart.

# Where the API lives.
#
# Leave blank for local development and for any deployment that serves the
# API from the same origin (Firebase Hosting rewrites /api/** to Cloud Run,
# so the console stays same-origin there and the session cookie is
# first-party).
#
# Set it to the API's origin when the two are hosted separately — the console
# on Vercel and the API on Render, for example:
#
#   VITE_API_URL=https://dvein-hrm-api.onrender.com
#
# Doing that makes every request cross-origin, which needs three things on the
# backend or sign-in fails silently: this origin listed in CORS_ORIGINS,
# COOKIE_SAMESITE=none, and COOKIE_SECURE=true. Even then the session cookie
# is third-party, and Safari blocks those by default. Putting both on
# subdomains of one domain and setting COOKIE_DOMAIN is the way to avoid it.
VITE_API_URL=
