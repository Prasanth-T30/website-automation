# Copy to .env.local for local overrides. Vite only exposes VITE_* to the
# browser, and these are baked in at build time — a change here needs a
# rebuild, not a restart.

# Where the API lives.
#
# Leave this BLANK for every supported deployment. Blank means the console
# calls /api/v1 on its own origin, and something in front forwards it to the
# API:
#
#   local dev          Vite's dev proxy (see vite.config.js)
#   Vercel             the /api rewrite in vercel.json
#   Firebase Hosting   the /api rewrite in firebase.json
#
# That is not a convenience — it is what keeps sign-in working. Auth rides on
# an httpOnly cookie. If the browser talks to the API on a different domain,
# that cookie is third-party, and Safari blocks third-party cookies outright
# while Chrome is restricting them. Proxying keeps it first-party, so the
# session survives in every browser and no CORS preflight is needed.
#
# Only set an absolute origin if you deliberately want the browser to reach
# the API directly:
#
#   VITE_API_URL=https://dvein-hrm-api.onrender.com
#
# Doing so also requires this site's origin in the API's CORS_ORIGINS, plus
# COOKIE_SAMESITE=none and COOKIE_SECURE=true — and it will still fail in
# Safari unless both hosts share a parent domain and COOKIE_DOMAIN is set.
VITE_API_URL=
