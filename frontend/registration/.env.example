# Where the public form sends registrations.
#
# Leave this relative in any deployment where the form and the HRM API sit
# behind one host — the bundled nginx config proxies /api through to the API,
# which keeps the browser same-origin and avoids a CORS preflight on every
# submission. Set an absolute origin only when the two live on separate
# domains, and add that origin to the API's CORS_ORIGINS if you do.
#
# Vite inlines this at build time, so it must be set before `pnpm build`
# (or passed as the VITE_API_BASE_URL build arg), not at container start.
VITE_API_BASE_URL=/api/v1

# Alternative to the line above: give the API's origin and let the client
# append /api/v1 itself. Use whichever reads better; VITE_API_BASE_URL wins
# if both are set.
#
#   VITE_API_URL=https://dvein-hrm-api.onrender.com
#
# On Vercel this is the one to set, since there is no nginx in front to proxy
# /api. Add the resulting site origin to the API's CORS_ORIGINS.
