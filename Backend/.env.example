ENV=development
DEBUG=true

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Registration-Site (public form) + Admin-Site (login/dashboard) — two separate apps, one shared backend
CORS_ORIGINS=http://localhost:5174,http://localhost:5175,http://localhost:5173,http://localhost:3000

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=internship_portal

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_brevo_smtp_username
SMTP_PASSWORD=your_brevo_smtp_password
SMTP_FROM_EMAIL=info@dveininnovation.com
SMTP_FROM_NAME=DVein Innovations

MAX_UPLOAD_SIZE_MB=5

DEFAULT_ADMIN_EMAIL=admin@dveininnovation.com
DEFAULT_ADMIN_PASSWORD=Admin@12345
