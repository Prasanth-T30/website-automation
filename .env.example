# Copy to .env and fill in the blanks.  Never commit .env.

# ── Firebase ────────────────────────────────────────────
# Production: create a service account (Firebase Console → Project Settings →
# Service Accounts → Generate new private key) and point this at the JSON file.
# Leave unset for local dev — the emulator hosts below are used instead.
FIREBASE_PROJECT_ID=demo-dvein-hrm
FIREBASE_SERVICE_ACCOUNT_PATH=
# The same credential as a value, for hosts with environment variables but
# no writable disk to keep a key file on (Render, Railway, Fly). Paste the
# whole service-account JSON, or a base64 copy of it if the dashboard
# mangles newlines. Ignored when the path above is set.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_STORAGE_BUCKET=demo-dvein-hrm.appspot.com

# Local dev only — matches firebase.json. Leave BOTH unset in production.
# Start the emulators with:  firebase emulators:start --only firestore,storage
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ── Security ──────────────────────────────────────────
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Must be true in production (requires HTTPS).
# 'none' is required when the console and API sit on different domains
# (Firebase Hosting + Cloud Run); it forces COOKIE_SECURE=true too.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ── Application ───────────────────────────────────────
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated. Must list every origin that calls the API from a browser:
# the console, and the deployed public registration form.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
PUBLIC_BASE_URL=http://localhost:5173

# Timestamps are stored in UTC. This is the clock monthly revenue is bucketed
# on — set it to the institute's own timezone, or the figures for the opening
# hours of each month land in the month before.
REPORTING_TIMEZONE=Asia/Kolkata

# ── Uploads ───────────────────────────────────────────
# Files themselves live in Firebase Storage; this governs validation only.
MAX_UPLOAD_MB=50

# ── Rate limits ───────────────────────────────────────
# Two tiers: the per-minute figure stops a script, the hourly one bounds
# sustained abuse. Both are counted per IP — and an IP is a network, not a
# person. A college lab registering thirty students shares one address, so a
# tight hourly cap rejects real applicants who have no way to tell a 429 apart
# from the site being broken. Duplicates are already impossible (transaction
# ids are unique, and every submission carries a payment screenshot), so the
# budget here is deliberately generous.
PUBLIC_FORM_RATE_LIMIT=20/minute;200/hour
LOGIN_RATE_LIMIT=10/minute;100/hour

# Blank = in-memory, which counts per process. Cloud Run runs several
# instances under load, so the real limit becomes the configured one times the
# instance count. Point this at Redis for any multi-instance deployment.
RATE_LIMIT_STORAGE_URI=

# ── Email (approval / rejection notices) ──────────────
# DELIBERATELY BLANK. Setting SMTP_HOST is the switch that turns sending on;
# until then the app logs a warning and carries on, so issuing a certificate or
# approving a student never depends on a mail server being reachable.
# Username and password are optional — a local mail catcher wants neither.
#
# Leave these unset anywhere you restore production data into a test
# environment — otherwise approving a record there emails the real applicant.
# Gmail example: smtp.gmail.com, port 587, starttls, full Gmail address as the
# username, and a 16-character Google App Password (never the account password).
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587, most providers) | ssl (port 465, TLS from the first
# byte — starttls cannot talk to it) | none (local mail catcher only,
# never against a real provider: the password would go in the clear).
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=info@dveininnovation.com
SMTP_FROM_NAME=Dvein Innovations
SMTP_REPLY_TO=

# ── Seed accounts (used once, by `python -m app.cli seed`) ────
SEED_ADMIN_EMAIL=admin@dvein.in
SEED_ADMIN_PASSWORD=
SEED_HR_PASSWORD=

# ---- Scheduled document sending ----------------------
# Offer letters go out once a student has paid; certificates once their
# programme has ended. Nobody reviews these before they send, so this stays
# off unless you deliberately turn it on.
AUTOMATION_ENABLED=false
# A single run will never send more than this, so a bad query or a bulk
# import cannot become hundreds of emails.
AUTOMATION_MAX_PER_RUN=25
# Shared secret for the scheduler that POSTs /api/v1/automation/run.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave blank and only a signed-in admin can trigger a run.
AUTOMATION_TOKEN=
